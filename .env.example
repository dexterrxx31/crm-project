# --- Required to run the app ---------------------------------------------

# The app connects as `synapse_app`, a NON-superuser role. This matters: a
# superuser bypasses row-level security even on FORCE'd tables, which would
# silently disable tenant isolation. Created by `bun run db:migrate`.
DATABASE_URL="postgresql://synapse_app:synapse_app@localhost:5433/synapse"

# Owner role — needs DDL rights, used only by migrations. In production this is
# your provider's owner connection string; never ship it to the running app.
DATABASE_ADMIN_URL="postgresql://synapse:synapse@localhost:5433/synapse"

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- AI (optional in dev; features degrade gracefully when unset) ---------

# https://console.anthropic.com — powers the agent, scoring and summaries
ANTHROPIC_API_KEY=""

# https://voyageai.com — embeddings for semantic search and dedupe
VOYAGE_API_KEY=""

# --- Background jobs (optional in dev; Inngest dev server needs no keys) --

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Email (optional) ----------------------------------------------------

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Synapse CRM <onboarding@resend.dev>"

# --- Rate limiting (optional in dev; AI routes run unlimited without it) --

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Observability (optional) --------------------------------------------

SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
